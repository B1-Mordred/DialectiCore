# Synthetic local test configuration.
# This keeps the stack on mock/local adapters and does not require paid API keys.

DIALECTICORE_ENV=development
DIALECTICORE_DATABASE_URL=sqlite:///./dialecticore-synthetic-test.db
DIALECTICORE_REDIS_URL=redis://localhost:6379/0
DIALECTICORE_REDIS_EVENT_FANOUT_ENABLED=false
DIALECTICORE_REDIS_WORKER_SIGNAL_ENABLED=false

DIALECTICORE_AUTH_ENABLED=false
DIALECTICORE_AUTH_API_KEY_REFERENCE=

DIALECTICORE_OBJECT_STORAGE_BACKEND=local
DIALECTICORE_OBJECT_STORAGE_LOCAL_PATH=./storage/synthetic/object-store
DIALECTICORE_RUNTIME_STATE_PATH=./storage/synthetic/runtime-state
DIALECTICORE_BACKUP_PATH=./storage/synthetic/backups

DIALECTICORE_TEMPORAL_BACKEND_MODE=local
DIALECTICORE_TEMPORAL_BACKEND_ADDRESS=
DIALECTICORE_TEMPORAL_BACKEND_WORKER_ENABLED=false
DIALECTICORE_TEMPORAL_SIGNAL_TRANSPORT_ENABLED=false

DIALECTICORE_MODEL_PROVIDER=mock
DIALECTICORE_PUBLISHER_AUTOMATED_LIVE_ENABLED=false
DIALECTICORE_RESEARCH_DISCOVERY_ENABLED=false
DIALECTICORE_RESEARCH_DISCOVERY_URL_TEMPLATE=
DIALECTICORE_RESEARCH_ADVANCED_EXTRACTION_ENABLED=false
DIALECTICORE_RESEARCH_ADVANCED_EXTRACTION_URL=

MINIO_ROOT_USER=synthetic
MINIO_ROOT_PASSWORD=synthetic
POSTGRES_DB=dialecticore
POSTGRES_USER=dialecticore
POSTGRES_PASSWORD=dialecticore
